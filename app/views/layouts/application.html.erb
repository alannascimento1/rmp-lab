<!DOCTYPE html>
<html>
  <head>
    <title>Laboratório Profiler</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>
  <body>
    <nav>
      <a class="brand" href="/">Laboratório Profiler</a>
      <section>
        <h4>1. N+1</h4>
        <%= link_to "ruim",  lab_posts_path,       class: "bad" %>
        <%= link_to "bom",   fixed_lab_posts_path, class: "good" %>
      </section>
      <section>
        <h4>2. Render de view</h4>
        <%= link_to "ruim",  lab_post_rows_path,       class: "bad" %>
        <%= link_to "bom",   fixed_lab_post_rows_path, class: "good" %>
      </section>
      <section>
        <h4>3. Indice</h4>
        <%= link_to "ruim",  lab_lookups_path, class: "bad" %>
        <%= link_to "bom",   fixed_lab_lookups_path,    class: "good" %>
      </section>
      <section>
        <h4>4. Cache</h4>
        <%= link_to "ruim",  lab_rankings_path, class: "bad" %>
        <%= link_to "bom",   fixed_lab_rankings_path,   class: "good" %>
      </section>
      <section>
        <h4>5. Contagem</h4>
        <%= link_to "count x counter_cache", lab_post_counts_path %>
      </section>
      <section>
        <h4>6. Fora do SQL</h4>
        <%= link_to "API externa", lab_quotes_path %>
        <%= link_to "CPU em Ruby", lab_scores_path %>
      </section>
    </nav>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
